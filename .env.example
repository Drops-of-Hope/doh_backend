# Copy to .env and fill in real values. Never commit .env.
# All variables marked (required) make the server refuse to start if missing.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/dropsofhope

# Secret for locally issued HS256 JWTs (required — no fallback).
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Server
PORT=5000
NODE_ENV=development

# Asgardeo (identity provider)
ASGARDEO_ORG=dropsofhope
# Derived defaults use https://api.asgardeo.io/t/${ASGARDEO_ORG}; override only if needed.
# ASGARDEO_BASE_URL=
# ASGARDEO_JWKS_URI=
# ASGARDEO_ISSUER=
# Optional: enforce the token audience (your Asgardeo client ID)
# ASGARDEO_AUDIENCE=
# Needed only for SCIM/admin API flows (role management)
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=

# Comma-separated browser origins allowed by CORS. Leave empty to block all
# browser cross-origin requests (native mobile apps are unaffected).
CORS_ALLOWED_ORIGINS=
